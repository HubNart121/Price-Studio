# Docker local: PostgreSQL และเข้าใช้งานโดยไม่ต้อง Login
APP_PORT=3016
DB_PORT=55432
POSTGRES_PASSWORD=pricing_password
DATABASE_URL=postgresql://pricing:pricing_password@127.0.0.1:55432/pricing?schema=public
DATA_BACKEND=postgres
AUTH_MODE=nextauth
LOCAL_AUTH_BYPASS=true
DEV_AUTH_EMAIL=nart@example.com
ALLOWED_EMAILS=nart@example.com
AUTH_URL=http://localhost:3016
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
PRODUCT_PRICE_PUBLIC_URL=http://localhost:3016

# Firebase local/deployment: เปลี่ยน DATA_BACKEND และ AUTH_MODE เป็นค่าด้านล่าง
# DATA_BACKEND=firestore
# AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web SDK; App Hosting สร้าง FIREBASE_WEBAPP_CONFIG ให้อัตโนมัติ
# กรอก NEXT_PUBLIC_* เฉพาะเมื่อรัน Firebase Authentication นอก App Hosting
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# MCP server สำหรับต่อ ChatGPT/Codex
MCP_PORT=3025
MCP_OWNER_EMAIL=nart@example.com
MCP_OWNER_NAME=Nart
MCP_SHARED_SECRET=replace-with-a-random-mcp-secret
